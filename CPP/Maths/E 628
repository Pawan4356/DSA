628. Maximum Product of Three Numbers

Given an integer array nums, find three numbers whose product is maximum and return the maximum product.

Example 1:

Input: nums = [1,2,3]
Output: 6
Example 2:

Input: nums = [1,2,3,4]
Output: 24
Example 3:

Input: nums = [-1,-2,-3]
Output: -6
 

Constraints:

3 <= nums.length <= 104
-1000 <= nums[i] <= 1000

class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        sort(begin(nums), end(nums));
        int len = nums.size();
        int result = nums[len - 1] * nums[len - 2] * nums[len - 3];
        if (len > 3) {
            result = max(result, nums[len - 1] * nums[0] * nums[1]);
        }
        return result;
    }
};